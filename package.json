{
  "name": "tuimsg",
  "version": "0.2.0",
  "description": "Messages TUI over imsg, built for SSH",
  "type": "module",
  "bin": {
    "tuimsg": "./bin/tuimsg"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "dev": "bun src/cli.tsx",
    "tuimsg": "bun src/cli.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && bun scripts/ui-verify.tsx",
    "test:unit": "vitest run",
    "test:ui": "bun scripts/ui-verify.tsx",
    "test:colors": "env -u NO_COLOR FORCE_COLOR=2 TERM=xterm-256color bun scripts/color-verify.tsx .audit/colors",
    "smoke": "bun scripts/pty-smoke.ts",
    "smoke:images": "bun scripts/image-smoke.ts",
    "build": "bun build src/cli.tsx --target bun --packages external --outfile dist/cli.js",
    "prepack": "bun run build"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "license": "MIT",
  "keywords": [
    "imessage",
    "imsg",
    "tui",
    "messages",
    "ssh"
  ],
  "dependencies": {
    "chalk": "^5.6.2",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "sharp": "^0.35.4",
    "string-width": "^8.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "bun-types": "^1.4.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
