{
  "name": "tuimsg",
  "version": "0.1.0",
  "description": "Messages.app TUI over BlueBubbles",
  "type": "module",
  "bin": {
    "imsg": "./bin/imsg",
    "tuimsg": "./bin/imsg"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "dev": "bun src/cli.tsx",
    "imsg": "bun src/cli.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && bun scripts/ui-verify.tsx",
    "test:unit": "vitest run",
    "test:ui": "bun scripts/ui-verify.tsx",
    "test:colors": "env -u NO_COLOR FORCE_COLOR=2 bun scripts/color-verify.tsx .audit/colors",
    "smoke": "bun scripts/pty-smoke.ts",
    "smoke:setup": "bun scripts/setup-smoke.ts",
    "smoke:images": "bun scripts/image-smoke.ts",
    "build": "bun build src/cli.tsx --target bun --packages external --outfile dist/cli.js",
    "prepack": "bun run build"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "license": "MIT",
  "author": "Panic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PanicIsReal/tuiMsg.git"
  },
  "homepage": "https://github.com/PanicIsReal/tuiMsg",
  "bugs": {
    "url": "https://github.com/PanicIsReal/tuiMsg/issues"
  },
  "keywords": [
    "imessage",
    "bluebubbles",
    "tui",
    "messages"
  ],
  "dependencies": {
    "chalk": "^5.6.2",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "string-width": "^8.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "bun-types": "^1.4.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
